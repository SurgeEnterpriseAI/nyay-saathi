# Copy to .env (never commit .env). Everything is optional: with no LLM set,
# the app runs in offline mode using the same verified tools.
PORT=8080

# Any OpenAI-compatible chat endpoint with tool calling, e.g. a local Ollama:
#   LLM_BASE_URL=http://localhost:11434/v1   LLM_MODEL=qwen2.5:7b-instruct
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_MS=30000
# Extra request fields (JSON), e.g. {"chat_template_kwargs":{"enable_thinking":false}} for Qwen on vLLM
LLM_EXTRA_BODY=

# Analytics (SQLite file). A random salt is created next to the DB if unset.
ANALYTICS_DB=./data/analytics.db
ANALYTICS_SALT=

# Per-IP chat limit per 10 minutes. Set TRUST_PROXY=1 only behind a reverse proxy.
CHAT_LIMIT_PER_10MIN=30
TRUST_PROXY=
